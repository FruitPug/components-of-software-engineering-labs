@startuml
actor RegisteredUser as user
participant "Web Interface" as ui
participant "AuthService" as auth
participant "ReviewService" as reviewSvc
participant "RatingService" as ratingSvc
database "Database" as db

user -> ui : 1. writeReview(bookId, rating, comment)
activate ui

alt Valid Session
    ui -> auth : 2. validateUser(sessionToken)
    activate auth
    auth --> ui : 3. validationSuccessful()
    deactivate auth

    ui -> reviewSvc : 4. createReview(userId, bookId, rating, comment)
    activate reviewSvc
    reviewSvc -> db : 5. INSERT INTO Review(user_id, book_id, rating, comment)
    activate db
    db --> reviewSvc : 6. reviewCreated()
    deactivate db

    reviewSvc -> ratingSvc : 7. updateBookRating(bookId)
    activate ratingSvc

    ratingSvc -> db : 8. UPDATE Book SET rating = newRating, review_count = newReviewCount WHERE book_id = bookId
    activate db
    db --> ratingSvc : 9. ratingUpdated()
    deactivate db

    ratingSvc --> reviewSvc : 10. ratingUpdated()
    deactivate ratingSvc
    destroy ratingSvc

    reviewSvc --> ui : 11. reviewCreatedSuccessfully()
    deactivate reviewSvc
    destroy reviewSvc

    ui --> user : 12. displayMessage("Review added successfully")
else Invalid Session
    ui -> auth : 2. validateUser(sessionToken)
    activate auth
    auth --> ui : 3.2. validationFailed()
    deactivate auth
    ui --> user : 3.3. displayMessage("You must be logged in to post a review")
    deactivate ui
end

@enduml
